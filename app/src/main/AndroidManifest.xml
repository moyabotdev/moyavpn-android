<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Split-Tunneling: wir zeigen dem Nutzer die startbaren Apps zur Auswahl.
      Der LAUNCHER-<queries>-Filter reicht dafuer aus — KEIN QUERY_ALL_PACKAGES
      (und damit keine zusaetzliche Play-Deklaration) noetig.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      Der VPN-Dienst selbst (android.net.VpnService) wird von der
      WireGuard-tunnel-Library (com.wireguard.android.backend.GoBackend$VpnService)
      bereitgestellt und automatisch ins Manifest gemerged. Wir muessen ihn hier
      nicht deklarieren. Beim Wechsel auf AmneziaWG bringt deren Library den
      entsprechenden Dienst mit.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoyaVPN">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MoyaVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link: moyavpn://login?token=...  → App öffnet & loggt automatisch ein -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moyavpn" android:host="login" />
            </intent-filter>

            <!-- App Link: https://app.moyabot.ru/i/...  (öffnet App direkt, sobald
                 assetlinks.json auf der Domain hinterlegt ist — sonst Auswahldialog) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.moyabot.ru" android:pathPrefix="/i" />
            </intent-filter>
        </activity>

        <!--
          Unsichtbare Brücke für Widget-Taps: holt (nur beim ersten Mal) die
          VPN-Erlaubnis und schaltet dann den Tunnel. Translucent + noHistory +
          excludeFromRecents, damit sie nicht sichtbar haengt.
        -->
        <activity
            android:name=".widget.WidgetProxyActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />

        <!-- Homescreen-Widget: 1-Tap-Connect (Favorit) -->
        <receiver
            android:name=".widget.ConnectWidgetProvider"
            android:exported="false"
            android:label="@string/widget_connect_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_connect_info" />
        </receiver>

        <!-- Homescreen-Widget: Server wechseln -->
        <receiver
            android:name=".widget.SwitchWidgetProvider"
            android:exported="false"
            android:label="@string/widget_switch_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_switch_info" />
        </receiver>

    </application>
</manifest>
